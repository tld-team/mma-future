{
  "name": "mma-future",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "mix",
    "watch": "mix watch",
    "watch-poll": "mix watch -- --watch-options-poll=1000",
    "hot": "mix watch --hot",
    "build": "mix --production && npm run tw_build && node build-manifest.js",
    "prod": "npm run build",
    "production": "npm run build",
    "copy-fonts": "node copy-fonts.js",
    "tw": "npm run copy-fonts && npx @tailwindcss/cli -i ./assets/src/css/input.css -o ./assets/dist/css/output.css --watch",
    "tw_build": "npm run copy-fonts && npm run copy-integration-styles && npx @tailwindcss/cli -i ./assets/src/css/input.css -o ./assets/dist/css/output.css --minify",
    "copy-integration-styles": "cp assets/src/css/integration.css assets/dist/css/integration.css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "laravel-mix": "^6.0.49",
    "sass": "^1.101.0",
    "sass-loader": "^12.6.0",
    "tailwindcss": "^4.0.0"
  }
}
